<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/home_widget_background"
    android:contentDescription="@string/home_widget_label">
    <ImageView android:id="@+id/home_widget_icon" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/home_widget_key" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/home_widget_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_widget_preview_name" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/home_widget_state" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_widget_unknown" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" />
        <TextView android:id="@+id/home_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_widget_idle" android:maxLines="1" android:ellipsize="end" android:textColor="#CCCCCC" android:textSize="11sp" android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
