<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="4dp" android:background="@drawable/home_widget_background"
    android:contentDescription="@string/home_widget_label">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/home_widget_key" android:contentDescription="@null" />
    <TextView android:id="@+id/home_widget_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="SESAME" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="11sp" />
    <TextView android:id="@+id/home_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/home_widget_unconfigured" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="9sp" />
</LinearLayout>
